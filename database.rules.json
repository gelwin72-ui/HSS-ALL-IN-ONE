{
  "rules": {
    "schools": {
      "$schoolCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "email_accounts": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "broadcasts": {
      "$broadcastId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "unauthorizedAttempts": {
      ".read": "auth != null",
      ".write": "true"
    },
    "teacherSignups": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "teachers": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}